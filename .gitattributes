# Keep line endings sane across Windows/Linux.
* text=auto eol=lf

# Dev-only files are kept out of the release package (git archive honors this).
/.github        export-ignore
/.gitattributes export-ignore
/.gitignore     export-ignore
/.scratch       export-ignore
/docs           export-ignore
CLAUDE.md       export-ignore
WORKFLOW.md     export-ignore

# Dev harness (wp-env + Playwright) — not part of the installable package.
/tests               export-ignore
/scripts             export-ignore
.wp-env.json         export-ignore
playwright.config.ts export-ignore
package.json         export-ignore
package-lock.json    export-ignore
